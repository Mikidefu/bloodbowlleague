# Copia questo file in .env.local e compila i valori.
# Su Vercel vanno impostati in Project Settings > Environment Variables.

# Database Turso
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob (upload loghi)
BLOB_READ_WRITE_TOKEN=

# Password dell'admin di lega: senza questa variabile tutte le modifiche sono bloccate
ADMIN_PASSWORD=

# Notifiche push della companion app (facoltative: senza queste l'opzione non compare).
# Si generano una volta con: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://bloodbowlleaguetrivium.vercel.app
